{
  "name": "@helix/runtime",
  "version": "0.1.0",
  "description": "Harness runtime for building AI agents — agent loop, tool orchestration, event streaming",
  "license": "MIT",
  "author": "helix-harness",
  "repository": "https://github.com/helix-harness/runtime",
  "bugs": "https://github.com/helix-harness/runtime/issues",
  "homepage": "https://github.com/helix-harness/runtime#readme",
  "keywords": ["ai", "agent", "llm", "harness", "runtime", "tool-calling"],
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --watch --format esm --dts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@helix/core": "workspace:*"
  }
}